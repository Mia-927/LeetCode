//Q1
class Solution {
    public int[] getConcatenation(int[] nums) {
        int n = nums.length;
        int[] ans = new int[2*n];
        for(int i = 0; i < n; i++){//[1234]
            ans[i] = nums[i];//1,2,3,4, 1(0+4-1),2,3,4
            ans[i + n] = nums[i];
        }
        return ans;
    }
}

//Q2
class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] aws = new int[2 * n];
        for(int i = 0; i < n; i++){
            aws[2*i] = nums[i];
            aws[2*i+1] = nums[i+n];
        }
        return aws;
    }
}

//Q3
class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int count = 0;
        int max = 0;
        for(int i = 0; i < nums.length; i++){
            if(nums[i]==1) count ++;
            if(nums[i]==0){
                if(count > max) max = count;
                count=0;
            }

        }
        if(count > max) max = count;
        return max;
    }
}
